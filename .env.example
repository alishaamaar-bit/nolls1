# Application
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nolls_db

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=7d

# Redis
REDIS_URL=redis://localhost:6379

# API URLs
STOREFRONT_URL=http://localhost:3000
ADMIN_DASHBOARD_URL=http://localhost:3001
API_BASE_URL=http://localhost:5000

# Payment Gateways
SUPERQI_API_KEY=your-superqi-key
SUPERQI_API_URL=https://api.superqi.com
ZAINCASH_API_KEY=your-zaincash-key
ZAINCASH_API_URL=https://api.zaincash.com

# Shipping Services
SHIPPING_PROVIDER_API_KEY=your-shipping-key

# Email Service
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# SMS Service
SMS_SERVICE=nexmo
SMS_API_KEY=your-sms-key
SMS_API_SECRET=your-sms-secret

# Analytics
GOOGLE_ANALYTICS_ID=your-ga-id
META_PIXEL_ID=your-meta-pixel-id
TIKTOK_PIXEL_ID=your-tiktok-pixel-id

# WhatsApp
WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_API_KEY=your-whatsapp-key

# AWS S3 (for media storage)
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=nolls-media

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
